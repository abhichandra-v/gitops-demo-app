# Single source of pinned versions. Looked up on 2026-10-13.
# Sourced by the Makefile and scripts; keep it plain KEY=value (no quotes, no spaces).

# --- Local tools (make doctor compares installed versions against these) ---
KIND_VERSION=v0.33.0
KUBECTL_VERSION=v1.34.1
HELM_VERSION=v3.17.0
KUSTOMIZE_VERSION=v5.8.3
ARGOCD_CLI_VERSION=v3.5.5
ARGO_ROLLOUTS_PLUGIN_VERSION=v1.10.1
GO_VERSION=1.27.2
YQ_VERSION=v4.54.1

# --- Cluster ---
KIND_CLUSTER_NAME=gitops-rollback
KIND_NODE_K8S_VERSION=1.36.4
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed

# --- Helm charts (chart version, with the app version it ships) ---
# argo-cd chart 10.10.3 -> Argo CD v3.5.5
ARGOCD_CHART_VERSION=10.10.3
# argo-rollouts chart 2.43.7 -> Argo Rollouts v1.10.1
ARGO_ROLLOUTS_CHART_VERSION=2.43.7
# ingress-nginx chart 4.15.1 -> controller 1.15.1
INGRESS_NGINX_CHART_VERSION=4.15.1
# kube-prometheus-stack chart 92.3.0 -> prometheus-operator v0.94.1
KUBE_PROMETHEUS_STACK_CHART_VERSION=92.3.0

# --- Git source of truth (what Argo CD syncs from) ---
GIT_REPO_URL=https://github.com/abhichandra-v/gitops-demo-app.git
GIT_TARGET_REVISION=main

# --- Images ---
DEMO_APP_IMAGE=ghcr.io/abhichandra-v/gitops-demo-app
FORTIO_VERSION=1.76.0

# --- CI validation tools ---
KUBECONFORM_VERSION=v0.8.0
KUBE_SCORE_VERSION=v1.20.0
CHECKOV_VERSION=3.3.28
GITLEAKS_VERSION=v8.30.1
